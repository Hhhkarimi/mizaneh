+import { beforeEach, describe, expect, it, vi } from "vitest";
+import {
+  clearSession,
+  hasSavedSession,
+  loadSession,
+  saveSession,
+} from "@/lib/storage/session";
+import { defaultForm } from "@/lib/food/catalogue";
+import type { PlannerForm } from "@/lib/types";
+
+function baseSession() {
+  return {
+    form: { ...defaultForm } as PlannerForm,
+    planMode: "variety" as const,
+    variationSeed: 3,
+    substitutions: {},
+  };
+}
+
+describe("session storage — explicit opt-in only", () => {
+  beforeEach(() => {
+    window.localStorage.clear();
+  });
+
+  it("has nothing saved by default", () => {
+    expect(hasSavedSession()).toBe(false);
+    expect(loadSession()).toBeNull();
+  });
+
+  it("saves and loads back exactly what was saved", () => {
+    const ok = saveSession(baseSession());
+    expect(ok).toBe(true);
+    expect(hasSavedSession()).toBe(true);
+
+    const loaded = loadSession();
+    expect(loaded).not.toBeNull();
+    expect(loaded?.form).toEqual(defaultForm);
+    expect(loaded?.planMode).toBe("variety");
+    expect(loaded?.variationSeed).toBe(3);
+    expect(loaded?.version).toBe(1);
+    expect(typeof loaded?.savedAt).toBe("string");
+  });
+
+  it("clears a saved session completely", () => {
+    saveSession(baseSession());
+    expect(hasSavedSession()).toBe(true);
+    const ok = clearSession();
+    expect(ok).toBe(true);
+    expect(hasSavedSession()).toBe(false);
+    expect(loadSession()).toBeNull();
+  });
+
+  it("discards and clears data with a mismatched version instead of applying it", () => {
+    window.localStorage.setItem(
+      "mizaneh:session:v1",
+      JSON.stringify({ version: 99, form: {}, variationSeed: 1 }),
+    );
+    expect(loadSession()).toBeNull();
+    // Discarding also removes the bad entry so it doesn't linger.
+    expect(window.localStorage.getItem("mizaneh:session:v1")).toBeNull();
+  });
+
+  it("discards corrupted JSON instead of throwing", () => {
+    window.localStorage.setItem("mizaneh:session:v1", "{not json");
+    expect(() => loadSession()).not.toThrow();
+    expect(loadSession()).toBeNull();
+  });
+
+  it("degrades to no-op (not a throw) if localStorage.setItem throws", () => {
+    const spy = vi
+      .spyOn(Storage.prototype, "setItem")
+      .mockImplementation(() => {
+        throw new Error("storage disabled");
+      });
+    expect(() => saveSession(baseSession())).not.toThrow();
+    expect(saveSession(baseSession())).toBe(false);
+    spy.mockRestore();
+  });
+
+  it("stores substitutions alongside the rest of the session", () => {
+    const session = baseSession();
+    saveSession({
+      ...session,
+      substitutions: {
+        0: {
+          id: "shanbe",
+          label: "شنبه",
+          shortLabel: "ش",
+          meals: [],
+          calories: 0,
+          protein: 0,
+          fiber: 0,
+        },
+      },
+    });
+    const loaded = loadSession();
+    expect(loaded?.substitutions[0]?.id).toBe("shanbe");
+  });
+});
diff --git a/lib/storage/session.ts b/lib/storage/session.ts
new file mode 100644
index 0000000..a7c3d25
--- /dev/null
+++ b/lib/storage/session.ts
@@ -0,0 +1,104 @@
+// Opt-in, device-local session persistence (round 2 — CONTEXT.md §9.3).
+//
+// Nothing here is ever called automatically on page load in a way that
+// writes or silently restores data — every function is only invoked from
+// an explicit user action in the UI (save button, restore-prompt choice,
+// clear button). This module never makes a network request; it only
+// wraps `window.localStorage`, and every call is defensively wrapped so a
+// disabled/unavailable storage API degrades to "nothing saved" rather
+// than throwing.
+
+import type { DayPlan, PlanMode, PlannerForm } from "@/lib/types";
+
+const STORAGE_KEY = "mizaneh:session:v1";
+const SESSION_VERSION = 1 as const;
+
+export type StoredSession = {
+  version: typeof SESSION_VERSION;
+  form: PlannerForm;
+  planMode: PlanMode;
+  variationSeed: number;
+  substitutions: Record<number, DayPlan>;
+  savedAt: string;
+};
+
+function getStorage(): Storage | null {
+  try {
+    if (typeof window === "undefined" || !window.localStorage) return null;
+    return window.localStorage;
+  } catch {
+    // Some browsers throw synchronously when storage is disabled
+    // (private mode, enterprise policy, etc.) rather than returning null.
+    return null;
+  }
+}
+
+/** Explicit save — only ever called from the "ذخیره روی این دستگاه" button. */
+export function saveSession(
+  session: Omit<StoredSession, "version" | "savedAt">,
+): boolean {
+  const storage = getStorage();
+  if (!storage) return false;
+  try {
+    const payload: StoredSession = {
+      version: SESSION_VERSION,
+      savedAt: new Date().toISOString(),
+      ...session,
+    };
+    storage.setItem(STORAGE_KEY, JSON.stringify(payload));
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+/**
+ * Reads any saved session without applying it to anything. The UI is
+ * expected to use this only to decide whether to show a "restore or
+ * discard?" prompt — never to silently repopulate the form.
+ */
+export function loadSession(): StoredSession | null {
+  const storage = getStorage();
+  if (!storage) return null;
+  try {
+    const raw = storage.getItem(STORAGE_KEY);
+    if (!raw) return null;
+    const parsed: unknown = JSON.parse(raw);
+    if (
+      !parsed ||
+      typeof parsed !== "object" ||
+      (parsed as { version?: unknown }).version !== SESSION_VERSION ||
+      typeof (parsed as { variationSeed?: unknown }).variationSeed !== "number" ||
+      !(parsed as { form?: unknown }).form
+    ) {
+      // Unknown/incompatible shape (e.g. a future version, or corrupted
+      // data) — discard rather than risk applying something malformed.
+      storage.removeItem(STORAGE_KEY);
+      return null;
+    }
+    return parsed as StoredSession;
+  } catch {
+    return null;
+  }
+}
+
+export function clearSession(): boolean {
+  const storage = getStorage();
+  if (!storage) return false;
+  try {
+    storage.removeItem(STORAGE_KEY);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+export function hasSavedSession(): boolean {
+  const storage = getStorage();
+  if (!storage) return false;
+  try {
+    return storage.getItem(STORAGE_KEY) !== null;
+  } catch {
+    return false;
+  }
+}
