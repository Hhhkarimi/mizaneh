+/* Disposable goal + cardiometabolic prototype. This route is non-indexed and
+   intentionally does not alter the production planner. */
+.prototype-shell {
+  min-height: 100vh;
+  padding-bottom: 80px;
+}
+
+.prototype-topbar {
+  align-items: center;
+  background: rgba(246, 241, 231, 0.94);
+  border-bottom: 1px solid var(--line);
+  display: flex;
+  justify-content: space-between;
+  padding: 18px clamp(22px, 5vw, 76px);
+  position: sticky;
+  top: 0;
+  z-index: 20;
+}
+
+.prototype-brand-mark {
+  align-items: center;
+  background: var(--ink);
+  border-radius: 50%;
+  color: white;
+  display: inline-flex;
+  font-size: 1.2rem;
+  font-variation-settings: "wght" 850;
+  height: 46px;
+  justify-content: center;
+  width: 46px;
+}
+
+.prototype-intro,
+.prototype-layout,
+.prototype-health-section,
+.prototype-sources {
+  margin-inline: auto;
+  max-width: 1180px;
+  padding-inline: clamp(18px, 4vw, 44px);
+}
+
+.prototype-intro {
+  padding-top: 70px;
+  text-align: center;
+}
+
+.prototype-intro h1 {
+  font-size: clamp(2.3rem, 6vw, 5rem);
+  letter-spacing: -0.055em;
+  line-height: 1.12;
+  margin-bottom: 18px;
+}
+
+.prototype-intro > p:not(.eyebrow) {
+  color: var(--muted);
+  margin-inline: auto;
+  max-width: 720px;
+}
+
+.prototype-variant-tabs {
+  display: grid;
+  gap: 10px;
+  grid-template-columns: repeat(3, 1fr);
+  margin-top: 32px;
+}
+
+.prototype-variant-tabs a {
+  background: var(--paper-2);
+  border: 1px solid var(--line);
+  border-radius: 999px;
+  padding: 10px 16px;
+}
+
+.prototype-variant-tabs a[aria-current="page"] {
+  background: var(--ink);
+  color: white;
+}
+
+.prototype-layout {
+  align-items: start;
+  display: grid;
+  gap: 24px;
+  grid-template-columns: minmax(0, 1fr) 280px;
+  margin-top: 34px;
+}
+
+.prototype-card {
+  width: 100%;
+}
+
+.prototype-tradeoff-card {
+  background: var(--coral-soft);
+  border: 1px solid var(--line);
+  border-radius: var(--radius-lg);
+  padding: 24px;
+  position: sticky;
+  top: 108px;
+}
+
+.prototype-tradeoff-card > span,
+.prototype-support-grid article > span,
+.prototype-health-result > span,
+.prototype-selection-summary > span,
+.prototype-recommendation > span {
+  color: var(--muted);
+  display: block;
+  font-size: 0.78rem;
+  margin-bottom: 7px;
+}
+
+.prototype-extended-selector {
+  display: grid;
+  gap: 10px;
+}
+
+.prototype-extended-selector button {
+  background: var(--paper);
+  border: 1px solid var(--line);
+  border-radius: var(--radius-md);
+  display: grid;
+  gap: 3px;
+  padding: 16px 18px;
+  text-align: right;
+}
+
+.prototype-extended-selector button span {
+  color: var(--muted);
+  font-size: 0.87rem;
+}
+
+.prototype-extended-selector button.is-selected,
+.prototype-manual-goals button.is-selected {
+  background: var(--lime-soft);
+  border-color: var(--ink);
+}
+
+.prototype-goal-cards {
+  display: grid;
+  gap: 12px;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+}
+
+.prototype-goal-cards article {
+  background: var(--paper);
+  border: 1px solid var(--line);
+  border-radius: var(--radius-md);
+  display: flex;
+  flex-direction: column;
+  padding: 18px;
+}
+
+.prototype-goal-cards article.is-selected {
+  background: var(--lime-soft);
+  border-color: var(--ink);
+}
+
+.prototype-goal-index {
+  color: var(--coral);
+  font-variation-settings: "wght" 800;
+}
+
+.prototype-goal-cards h3 {
+  margin: 8px 0 7px;
+}
+
+.prototype-goal-cards p,
+.prototype-goal-cards dd {
+  color: var(--muted);
+  font-size: 0.8rem;
+}
+
+.prototype-goal-cards dl {
+  display: grid;
+  gap: 10px;
+  margin: 10px 0 18px;
+}
+
+.prototype-goal-cards dl div {
+  border-top: 1px solid var(--line);
+  padding-top: 8px;
+}
+
+.prototype-goal-cards dt {
+  font-size: 0.74rem;
+  font-variation-settings: "wght" 750;
+}
+
+.prototype-goal-cards dd {
+  margin: 2px 0 0;
+}
+
+.prototype-goal-cards button,
+.prototype-manual-goals button {
+  background: var(--paper-2);
+  border: 1px solid var(--line);
+  border-radius: 999px;
+  margin-top: auto;
+  padding: 8px 12px;
+}
+
+.prototype-guided {
+  display: grid;
+  gap: 18px;
+}
+
+.prototype-recommendation,
+.prototype-selection-summary {
+  background: var(--blue-soft);
+  border: 1px solid var(--line);
+  border-radius: var(--radius-md);
+  padding: 16px 18px;
+}
+
+.prototype-recommendation strong,
+.prototype-selection-summary strong {
+  display: block;
+  font-size: 1.25rem;
+}
+
+.prototype-recommendation p,
+.prototype-selection-summary p {
+  color: var(--muted);
+  margin: 4px 0 0;
+}
+
+.prototype-manual-goals {
+  display: grid;
+  gap: 8px;
+  grid-template-columns: repeat(3, 1fr);
+}
+
+.prototype-selection-summary {
+  background: var(--paper-2);
+  margin-top: 20px;
+}
+
+.prototype-health-section {
+  background: var(--ink);
+  border-radius: var(--radius-xl);
+  color: var(--paper-2);
+  margin-top: 52px;
+  padding-block: 38px;
+}
+
+.prototype-health-section > header {
+  align-items: end;
+  display: flex;
+  gap: 30px;
+  justify-content: space-between;
+  margin-bottom: 26px;
+}
+
+.prototype-health-section > header p {
+  color: rgba(255, 255, 255, 0.7);
+  margin: 0;
+  max-width: 480px;
+}
+
+.prototype-health-grid {
+  display: grid;
+  gap: 14px;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+}
+
+.prototype-health-card {
+  background: var(--paper-2);
+  border: 1px solid rgba(255, 255, 255, 0.15);
+  border-radius: var(--radius-lg);
+  color: var(--ink);
+  margin: 0;
+  padding: 20px;
+}
+
+.prototype-health-card legend {
+  font-variation-settings: "wght" 800;
+  padding-inline: 5px;
+}
+
+.prototype-health-card > label:not(.prototype-toggle) {
+  display: grid;
+  gap: 7px;
+  margin-top: 12px;
+}
+
+.prototype-check-grid {
+  display: grid;
+  gap: 8px;
+  grid-template-columns: repeat(2, 1fr);
+}
+
+.prototype-toggle {
+  align-items: start;
+  display: flex;
+  gap: 9px;
+  margin-top: 12px;
+}
+
+.prototype-toggle input {
+  margin-top: 7px;
+}
+
+.prototype-field-note {
+  background: var(--blue-soft);
+  border-radius: 12px;
+  color: var(--ink-2);
+  font-size: 0.8rem;
+  margin: 14px 0 0;
+  padding: 10px 12px;
+}
+
+.prototype-health-result {
+  border: 1px solid rgba(255, 255, 255, 0.22);
+  border-radius: var(--radius-lg);
+  margin-top: 16px;
+  padding: 20px;
+}
+
+.prototype-health-result strong {
+  display: block;
+  font-size: 1.35rem;
+}
+
+.prototype-health-result p {
+  margin: 4px 0 0;
+}
+
+.prototype-health-result.is-ordinary { background: rgba(184, 219, 120, 0.18); }
+.prototype-health-result.is-support { background: rgba(220, 236, 235, 0.18); }
+.prototype-health-result.is-review { background: rgba(255, 230, 223, 0.17); }
+.prototype-health-result.is-priority,
+.prototype-health-result.is-urgent { background: rgba(255, 113, 91, 0.2); }
+
+.prototype-support-grid {
+  display: grid;
+  gap: 14px;
+  grid-template-columns: repeat(3, 1fr);
+  margin-top: 18px;
+}
+
+.prototype-support-grid article {
+  background: var(--paper-2);
+  border-radius: var(--radius-lg);
+  color: var(--ink);
+  padding: 20px;
+}
+
+.prototype-support-grid h3 {
+  font-size: 1rem;
+  margin-bottom: 8px;
+}
+
+.prototype-support-grid p {
+  color: var(--muted);
+  font-size: 0.82rem;
+  margin: 0;
+}
+
+.prototype-data-warning {
+  background: var(--coral-soft);
+  border-radius: var(--radius-md);
+  color: var(--ink);
+  margin-top: 18px;
+  padding: 16px 18px;
+}
+
+.prototype-data-warning p {
+  margin: 5px 0 0;
+}
+
+.prototype-sources {
+  margin-top: 50px;
+}
+
+.prototype-sources ul {
+  display: grid;
+  gap: 8px;
+  padding-right: 20px;
+}
+
+.prototype-sources p {
+  color: var(--muted);
+}
+
+@media (max-width: 940px) {
+  .prototype-layout,
+  .prototype-health-grid {
+    grid-template-columns: 1fr;
+  }
+
+  .prototype-tradeoff-card {
+    position: static;
+  }
+
+  .prototype-goal-cards,
+  .prototype-support-grid {
+    grid-template-columns: 1fr;
+  }
+
+  .prototype-health-section > header {
+    align-items: start;
+    flex-direction: column;
+  }
+}
+
+@media (max-width: 680px) {
+  .prototype-topbar {
+    padding: 12px 16px;
+  }
+
+  .prototype-topbar .header-action {
+    font-size: 0.76rem;
+    padding-inline: 14px;
+  }
+
+  .prototype-variant-tabs,
+  .prototype-manual-goals,
+  .prototype-check-grid {
+    grid-template-columns: 1fr;
+  }
+
+  .prototype-intro {
+    padding-top: 42px;
+  }
+
+  .prototype-health-section {
+    border-radius: 24px;
+    margin-inline: 12px;
+    padding-inline: 14px;
+  }
+}
